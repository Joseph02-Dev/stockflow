// Schéma Prisma — StockFlow
// Reflète strictement le modèle de données validé en phase Architecture,
// avec les 3 ajustements validés en audit Lead Developer (résolution auto
// des alertes sur entrée + archivage des emplacements au lieu de suppression).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GESTIONNAIRE
}

enum TypeMouvement {
  ENTREE
  SORTIE
  TRANSFERT
  AJUSTEMENT
}

enum StatutInventaire {
  EN_COURS
  TERMINE
}

enum StatutLigneInventaire {
  EN_ATTENTE
  VALIDEE
  IGNOREE
}

enum StatutCommande {
  BROUILLON
  ENVOYEE
  RECUE
  ANNULEE
}

enum TypeAlerte {
  STOCK_FAIBLE
  RUPTURE
}

enum StatutAlerte {
  ACTIVE
  RESOLUE
}

// Console opérateur — une entreprise suspendue garde toutes ses données
// (jamais de suppression physique) mais plus aucun de ses utilisateurs ne
// peut se connecter ni utiliser un token encore valide.
enum StatutEntreprise {
  ACTIVE
  SUSPENDUE
}

enum ActionAudit {
  CONNEXION
  CONSULTATION_ENTREPRISE
  SUSPENSION
  RETABLISSEMENT
  MODIFICATION_REGLAGES
}

enum SecteurActivite {
  MATERIAUX
  COMMERCE
  ARTISANAT
  AUTRE
}

model Entreprise {
  id        String   @id @default(uuid())
  nom       String
  createdAt DateTime @default(now()) @map("created_at")

  // Saisis à l'étape 2 de l'inscription. secteurActivite reste indicatif
  // (aucune logique n'en dépend pour l'instant) ; tauxTvaParDefaut, lui,
  // est réellement exploité : il pré-remplit le taux de TVA à la
  // création d'un nouveau produit, au lieu d'un champ toujours vide.
  secteurActivite  SecteurActivite? @map("secteur_activite")
  tauxTvaParDefaut Int?             @map("taux_tva_par_defaut")

  // Suspension d'accès par un opérateur de la plateforme (console).
  statut          StatutEntreprise @default(ACTIVE)
  suspendueAt     DateTime?        @map("suspendue_at")
  motifSuspension String?          @map("motif_suspension")

  // Réglages fixés par un opérateur (console, phase 2). Limite nulle =
  // illimité ; modules activés par défaut. Vérifiés côté serveur à chaque
  // création concernée, jamais seulement masqués dans l'interface.
  limiteEmplacements Int?    @map("limite_emplacements")
  limiteUtilisateurs Int?    @map("limite_utilisateurs")
  limiteReferences   Int?    @map("limite_references")
  moduleInventaires  Boolean @default(true) @map("module_inventaires")
  moduleTransferts   Boolean @default(true) @map("module_transferts")

  utilisateurs Utilisateur[]
  emplacements Emplacement[]
  produits     Produit[]
  clients      Client[]
  fournisseurs Fournisseur[]
  mouvements   Mouvement[]
  alertes      Alerte[]
  invitations  Invitation[]
  categories   Categorie[]
  marques      Marque[]
  inventaires  Inventaire[]
  commandes    CommandeFournisseur[]

  @@map("entreprise")
}

model Utilisateur {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  email        String   @unique
  nom          String
  photoUrl     String?  @map("photo_url")
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  // Verrouillage temporaire après plusieurs échecs de connexion
  // consécutifs (décision validée : 15 minutes après 5 tentatives).
  // Réinitialisé à 0 dès qu'une connexion réussit.
  tentativesEchouees Int       @default(0) @map("tentatives_echouees")
  bloqueJusqua       DateTime? @map("bloque_jusqua")

  // Double opt-in : le compte reste inactif (connexion refusée) tant que
  // ce champ n'est pas renseigné. Un utilisateur invité par email n'a
  // pas besoin de cette étape — accepter l'invitation prouve déjà la
  // possession de l'adresse (voir acceptInvite()), emailVerifieAt est
  // alors renseigné immédiatement.
  emailVerifieAt DateTime? @map("email_verifie_at")

  entreprise                  Entreprise                   @relation(fields: [entrepriseId], references: [id])
  mouvements                  Mouvement[]
  refreshTokens               RefreshToken[]
  invitationsEnvoyees         Invitation[]
  inventaires                 Inventaire[]
  inventaireLignesValidees    InventaireLigne[]
  commandes                   CommandeFournisseur[]
  reinitialisationsMotDePasse ReinitialisationMotDePasse[]
  verificationsEmail          VerificationEmail[]

  @@index([entrepriseId])
  @@map("utilisateur")
}

/**
 * Jeton de confirmation d'adresse email — même schéma que ReinitialisationMotDePasse.
 */
model VerificationEmail {
  id            String    @id @default(uuid())
  utilisateurId String    @map("utilisateur_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@map("verification_email")
}

/**
 * Jeton de réinitialisation de mot de passe — même schéma qu'Invitation
 * (hash du jeton, jamais le jeton en clair ; expiration ; usedAt plutôt
 * qu'une suppression physique, pour garder un historique d'audit).
 */
model ReinitialisationMotDePasse {
  id            String    @id @default(uuid())
  utilisateurId String    @map("utilisateur_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@map("reinitialisation_mot_de_passe")
}

// AUTH-003 — Invitation d'un utilisateur par un Admin.
// Aucun Utilisateur n'est créé tant que l'invitation n'est pas acceptée
// (l'email et le rôle sont réservés, mais le nom et le mot de passe sont
// choisis par la personne invitée lors de l'acceptation).
model Invitation {
  id           String    @id @default(uuid())
  entrepriseId String    @map("entreprise_id")
  email        String
  role         Role
  tokenHash    String    @unique @map("token_hash")
  invitedById  String    @map("invited_by_id")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  entreprise Entreprise  @relation(fields: [entrepriseId], references: [id])
  invitedBy  Utilisateur @relation(fields: [invitedById], references: [id])

  @@index([entrepriseId])
  @@index([email])
  @@map("invitation")
}

// Permet la révocation réelle côté serveur (AUTH-002 — déconnexion).
// On ne stocke jamais le token en clair, seulement son empreinte (hash
// déterministe SHA-256, suffisant pour un secret déjà à haute entropie —
// contrairement à un mot de passe, pas besoin d'un hash lent type argon2).
model RefreshToken {
  id            String    @id @default(uuid())
  utilisateurId String    @map("utilisateur_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@map("refresh_token")
}

model Emplacement {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  adresse      String?
  // Archivage plutôt que suppression physique — décision validée en audit
  // Lead Developer, pour préserver l'intégrité des mouvements historiques
  // qui référencent obligatoirement un emplacement.
  archive      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise      Entreprise            @relation(fields: [entrepriseId], references: [id])
  stocks          Stock[]
  mouvements      Mouvement[]
  // Transferts dont cet emplacement est la destination (la relation
  // "mouvements" ci-dessus couvre déjà la source de tous les mouvements,
  // transferts inclus).
  mouvementsRecus Mouvement[]           @relation("MouvementDestination")
  inventaires     Inventaire[]
  commandes       CommandeFournisseur[]

  @@index([entrepriseId])
  @@map("emplacement")
}

model Produit {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  reference    String?
  seuilAlerte  Int      @default(0) @map("seuil_alerte")
  archive      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  // Ajouts fiche produit enrichie — tous facultatifs pour ne pas casser
  // les produits existants créés avant cette évolution.
  photoUrl    String? @map("photo_url")
  // Montants en francs guinéens (GNF), une devise sans subdivision
  // décimale en circulation — stockés en entier, jamais en flottant.
  prixAchat   Int?    @map("prix_achat")
  // prixVente est, par convention, le prix de DÉTAIL (hors taxes). Il
  // n'est pas renommé : liste produits, export CSV, fiche produit et
  // maquettes l'utilisent déjà. Les prix de gros et de demi-gros sont
  // facultatifs et retombent sur prixVente (voir common/tarifs/prix.ts).
  prixVente    Int?   @map("prix_vente")
  prixGros     Int?   @map("prix_gros")
  prixDemiGros Int?   @map("prix_demi_gros")
  tauxTva     Int?    @map("taux_tva") // pourcentage, ex. 18 pour 18%
  codeBarre   String? @map("code_barre")
  description String?
  categorieId String? @map("categorie_id")
  marqueId    String? @map("marque_id")
  // Ex. "Unité", "Sac", "Barre", "Litre", "Kg" — texte libre plutôt qu'une
  // liste figée : les unités varient trop selon le secteur d'activité
  // pour être une entité de référence gérée comme catégorie/marque.
  uniteMesure String? @map("unite_mesure")

  entreprise           Entreprise           @relation(fields: [entrepriseId], references: [id])
  categorie            Categorie?           @relation(fields: [categorieId], references: [id])
  marque               Marque?              @relation(fields: [marqueId], references: [id])
  stocks               Stock[]
  mouvements           Mouvement[]
  alertes              Alerte[]
  fournisseursAssocies FournisseurProduit[]
  inventaireLignes     InventaireLigne[]
  commandeLignes       CommandeLigne[]

  @@unique([entrepriseId, codeBarre])
  @@index([entrepriseId, nom])
  @@map("produit")
}

// Entités de référence légères, gérées par l'Admin (comme les
// emplacements), utilisées pour classer les produits.
model Categorie {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produits   Produit[]

  @@unique([entrepriseId, nom])
  @@map("categorie")
}

model Marque {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produits   Produit[]

  @@unique([entrepriseId, nom])
  @@map("marque")
}

model Fournisseur {
  id                  String   @id @default(uuid())
  entrepriseId        String   @map("entreprise_id")
  nom                 String
  emailContact        String?  @map("email_contact")
  telephone           String?
  photoUrl            String?  @map("photo_url")
  // Saisi manuellement par l'Admin (délai annoncé par le fournisseur),
  // pas calculé depuis l'historique des réceptions — on n'a pas encore
  // de date de commande, seulement une date de réception.
  delaiLivraisonJours Int?     @map("delai_livraison_jours")
  createdAt           DateTime @default(now()) @map("created_at")

  entreprise       Entreprise            @relation(fields: [entrepriseId], references: [id])
  produitsAssocies FournisseurProduit[]
  mouvements       Mouvement[]
  commandes        CommandeFournisseur[]

  @@index([entrepriseId])
  @@map("fournisseur")
}

model FournisseurProduit {
  fournisseurId String @map("fournisseur_id")
  produitId     String @map("produit_id")

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id])
  produit     Produit     @relation(fields: [produitId], references: [id])

  @@id([fournisseurId, produitId])
  @@map("fournisseur_produit")
}

// État courant du stock, maintenu à chaque mouvement (voir justification
// dans la documentation d'architecture : évite un recalcul par somme à
// chaque lecture).
model Stock {
  produitId     String @map("produit_id")
  emplacementId String @map("emplacement_id")
  quantite      Int    @default(0)

  produit     Produit     @relation(fields: [produitId], references: [id])
  emplacement Emplacement @relation(fields: [emplacementId], references: [id])

  @@id([produitId, emplacementId])
  @@map("stock")
}

// Mouvements immuables : jamais modifiés ni supprimés après création
// (traçabilité — voir règles d'intégrité de l'architecture validée).
model Mouvement {
  id            String        @id @default(uuid())
  entrepriseId  String        @map("entreprise_id")
  produitId     String        @map("produit_id")
  emplacementId String        @map("emplacement_id")
  type          TypeMouvement
  quantite      Int
  fournisseurId String?       @map("fournisseur_id")
  utilisateurId String        @map("utilisateur_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Uniquement renseigné pour un TRANSFERT — emplacementId joue alors le
  // rôle de source. Relation nommée car deux relations distinctes
  // pointent vers Emplacement depuis ce même modèle.
  emplacementDestinationId String? @map("emplacement_destination_id")

  entreprise             Entreprise   @relation(fields: [entrepriseId], references: [id])
  produit                Produit      @relation(fields: [produitId], references: [id])
  emplacement            Emplacement  @relation(fields: [emplacementId], references: [id])
  emplacementDestination Emplacement? @relation("MouvementDestination", fields: [emplacementDestinationId], references: [id])
  fournisseur            Fournisseur? @relation(fields: [fournisseurId], references: [id])
  utilisateur            Utilisateur  @relation(fields: [utilisateurId], references: [id])

  @@index([produitId, createdAt])
  @@index([entrepriseId, createdAt])
  @@map("mouvement")
}

model Alerte {
  id                      String       @id @default(uuid())
  entrepriseId            String       @map("entreprise_id")
  produitId               String       @map("produit_id")
  type                    TypeAlerte
  statut                  StatutAlerte @default(ACTIVE)
  quantiteAuDeclenchement Int          @map("quantite_au_declenchement")
  createdAt               DateTime     @default(now()) @map("created_at")
  resolvedAt              DateTime?    @map("resolved_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produit    Produit    @relation(fields: [produitId], references: [id])

  @@index([entrepriseId, statut])
  @@map("alerte")
}

/**
 * Session de comptage physique portant sur tout le catalogue actif d'UN
 * emplacement (décision validée). À la création, une InventaireLigne est
 * générée pour chaque produit actif de l'entreprise — pas seulement ceux
 * ayant déjà du stock à cet emplacement, puisqu'un comptage doit aussi
 * révéler un produit qu'on croyait absent mais qui s'y trouve en réalité.
 */
model Inventaire {
  id            String           @id @default(uuid())
  entrepriseId  String           @map("entreprise_id")
  emplacementId String           @map("emplacement_id")
  statut        StatutInventaire @default(EN_COURS)
  utilisateurId String           @map("utilisateur_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  termineAt     DateTime?        @map("termine_at")

  entreprise  Entreprise        @relation(fields: [entrepriseId], references: [id])
  emplacement Emplacement       @relation(fields: [emplacementId], references: [id])
  utilisateur Utilisateur       @relation(fields: [utilisateurId], references: [id])
  lignes      InventaireLigne[]

  @@index([entrepriseId, emplacementId])
  @@map("inventaire")
}

/**
 * Une ligne par produit du catalogue au moment de la création de
 * l'inventaire. `quantiteComptee` reste nulle tant que personne n'a
 * saisi de comptage. L'écart n'est jamais stocké : il est toujours
 * recalculé face au stock RÉEL au moment de la validation (pas un
 * instantané pris à la création), pour ne jamais valider une correction
 * sur la base d'une donnée déjà périmée si du stock a bougé entre-temps.
 */
model InventaireLigne {
  id               String                @id @default(uuid())
  inventaireId     String                @map("inventaire_id")
  produitId        String                @map("produit_id")
  quantiteComptee  Int?                  @map("quantite_comptee")
  statutAjustement StatutLigneInventaire @default(EN_ATTENTE) @map("statut_ajustement")
  valideParId      String?               @map("valide_par_id")
  valideAt         DateTime?             @map("valide_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  inventaire Inventaire   @relation(fields: [inventaireId], references: [id])
  produit    Produit      @relation(fields: [produitId], references: [id])
  validePar  Utilisateur? @relation(fields: [valideParId], references: [id])

  @@unique([inventaireId, produitId])
  @@map("inventaire_ligne")
}

/**
 * Bon de commande fournisseur. Créée soit manuellement (produits choisis
 * librement), soit pré-remplie depuis les alertes actives d'un
 * fournisseur (décision validée) — les deux passent par la même route de
 * création, la distinction n'existe que côté frontend selon l'origine
 * de la saisie.
 */
model CommandeFournisseur {
  id            String         @id @default(uuid())
  entrepriseId  String         @map("entreprise_id")
  fournisseurId String         @map("fournisseur_id")
  emplacementId String         @map("emplacement_id")
  statut        StatutCommande @default(BROUILLON)
  utilisateurId String         @map("utilisateur_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  envoyeeAt     DateTime?      @map("envoyee_at")
  recueAt       DateTime?      @map("recue_at")

  entreprise  Entreprise      @relation(fields: [entrepriseId], references: [id])
  fournisseur Fournisseur     @relation(fields: [fournisseurId], references: [id])
  emplacement Emplacement     @relation(fields: [emplacementId], references: [id])
  utilisateur Utilisateur     @relation(fields: [utilisateurId], references: [id])
  lignes      CommandeLigne[]

  @@index([entrepriseId, fournisseurId])
  @@map("commande_fournisseur")
}

model CommandeLigne {
  id                String @id @default(uuid())
  commandeId        String @map("commande_id")
  produitId         String @map("produit_id")
  quantiteCommandee Int    @map("quantite_commandee")

  commande CommandeFournisseur @relation(fields: [commandeId], references: [id])
  produit  Produit             @relation(fields: [produitId], references: [id])

  @@unique([commandeId, produitId])
  @@map("commande_ligne")
}

/**
 * Opérateur de la plateforme (console). Volontairement distinct
 * d'Utilisateur : un opérateur n'appartient à aucune entreprise, et son
 * authentification utilise un secret JWT séparé (JWT_CONSOLE_SECRET).
 * Aucune interface ne permet d'en créer : script CLI uniquement.
 */
model Operateur {
  id                  String    @id @default(uuid())
  email               String    @unique
  nom                 String
  passwordHash        String    @map("password_hash")
  derniereConnexionAt DateTime? @map("derniere_connexion_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  journalEntrees JournalAudit[]

  @@map("operateur")
}

/**
 * Journal d'audit de la console : toute lecture ou modification des
 * données d'une entreprise par un opérateur y est inscrite. entrepriseId
 * est volontairement sans clé étrangère — le journal doit survivre même
 * si une entreprise disparaissait un jour.
 */
model JournalAudit {
  id           String      @id @default(uuid())
  operateurId  String      @map("operateur_id")
  action       ActionAudit
  entrepriseId String?     @map("entreprise_id")
  motif        String?
  detail       String?
  createdAt    DateTime    @default(now()) @map("created_at")

  operateur Operateur @relation(fields: [operateurId], references: [id])

  @@index([operateurId, createdAt])
  @@index([entrepriseId, createdAt])
  @@map("journal_audit")
}

// Catégorie tarifaire d'un client : détermine le prix appliqué à la vente
// (voir resoudrePrix côté ventes). DETAIL correspond au prixVente du produit.
enum CategorieTarifaire {
  GROS
  DEMI_GROS
  DETAIL
}

/// Client d'une entreprise. Jamais supprimé : archivé, pour que son
/// historique de ventes et de règlements survive.
model Client {
  id           String             @id @default(uuid())
  entrepriseId String             @map("entreprise_id")
  nom          String
  // Format international (+224 6XX XX XX XX) — sert aux liens WhatsApp.
  telephone    String?
  nomCommerce  String?            @map("nom_commerce")
  categorie    CategorieTarifaire @default(DETAIL)
  // En GNF, entier. Avertit à la vente, ne bloque jamais. Null = aucun plafond.
  plafondCredit Int?              @map("plafond_credit")
  archive      Boolean            @default(false)
  createdAt    DateTime           @default(now()) @map("created_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])

  @@index([entrepriseId, archive])
  @@map("client")
}
