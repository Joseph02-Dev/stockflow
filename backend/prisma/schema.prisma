// Schéma Prisma — StockFlow
// Reflète strictement le modèle de données validé en phase Architecture,
// avec les 3 ajustements validés en audit Lead Developer (résolution auto
// des alertes sur entrée + archivage des emplacements au lieu de suppression).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GESTIONNAIRE
}

enum TypeMouvement {
  ENTREE
  SORTIE
}

enum TypeAlerte {
  STOCK_FAIBLE
  RUPTURE
}

enum StatutAlerte {
  ACTIVE
  RESOLUE
}

model Entreprise {
  id        String   @id @default(uuid())
  nom       String
  createdAt DateTime @default(now()) @map("created_at")

  utilisateurs Utilisateur[]
  emplacements Emplacement[]
  produits     Produit[]
  fournisseurs Fournisseur[]
  mouvements   Mouvement[]
  alertes      Alerte[]
  invitations  Invitation[]
  categories   Categorie[]
  marques      Marque[]

  @@map("entreprise")
}

model Utilisateur {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  email        String   @unique
  nom          String
  photoUrl     String?  @map("photo_url")
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise          Entreprise     @relation(fields: [entrepriseId], references: [id])
  mouvements          Mouvement[]
  refreshTokens       RefreshToken[]
  invitationsEnvoyees Invitation[]

  @@index([entrepriseId])
  @@map("utilisateur")
}

// AUTH-003 — Invitation d'un utilisateur par un Admin.
// Aucun Utilisateur n'est créé tant que l'invitation n'est pas acceptée
// (l'email et le rôle sont réservés, mais le nom et le mot de passe sont
// choisis par la personne invitée lors de l'acceptation).
model Invitation {
  id           String    @id @default(uuid())
  entrepriseId String    @map("entreprise_id")
  email        String
  role         Role
  tokenHash    String    @unique @map("token_hash")
  invitedById  String    @map("invited_by_id")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  entreprise Entreprise  @relation(fields: [entrepriseId], references: [id])
  invitedBy  Utilisateur @relation(fields: [invitedById], references: [id])

  @@index([entrepriseId])
  @@index([email])
  @@map("invitation")
}

// Permet la révocation réelle côté serveur (AUTH-002 — déconnexion).
// On ne stocke jamais le token en clair, seulement son empreinte (hash
// déterministe SHA-256, suffisant pour un secret déjà à haute entropie —
// contrairement à un mot de passe, pas besoin d'un hash lent type argon2).
model RefreshToken {
  id            String    @id @default(uuid())
  utilisateurId String    @map("utilisateur_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@map("refresh_token")
}

model Emplacement {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  adresse      String?
  // Archivage plutôt que suppression physique — décision validée en audit
  // Lead Developer, pour préserver l'intégrité des mouvements historiques
  // qui référencent obligatoirement un emplacement.
  archive      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise  @relation(fields: [entrepriseId], references: [id])
  stocks     Stock[]
  mouvements Mouvement[]

  @@index([entrepriseId])
  @@map("emplacement")
}

model Produit {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  reference    String?
  seuilAlerte  Int      @default(0) @map("seuil_alerte")
  archive      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  // Ajouts fiche produit enrichie — tous facultatifs pour ne pas casser
  // les produits existants créés avant cette évolution.
  photoUrl    String? @map("photo_url")
  // Montants en francs guinéens (GNF), une devise sans subdivision
  // décimale en circulation — stockés en entier, jamais en flottant.
  prixAchat   Int?    @map("prix_achat")
  prixVente   Int?    @map("prix_vente")
  tauxTva     Int?    @map("taux_tva") // pourcentage, ex. 18 pour 18%
  codeBarre   String? @map("code_barre")
  description String?
  categorieId String? @map("categorie_id")
  marqueId    String? @map("marque_id")
  // Ex. "Unité", "Sac", "Barre", "Litre", "Kg" — texte libre plutôt qu'une
  // liste figée : les unités varient trop selon le secteur d'activité
  // pour être une entité de référence gérée comme catégorie/marque.
  uniteMesure String? @map("unite_mesure")

  entreprise           Entreprise           @relation(fields: [entrepriseId], references: [id])
  categorie            Categorie?           @relation(fields: [categorieId], references: [id])
  marque               Marque?              @relation(fields: [marqueId], references: [id])
  stocks               Stock[]
  mouvements           Mouvement[]
  alertes              Alerte[]
  fournisseursAssocies FournisseurProduit[]

  @@unique([entrepriseId, codeBarre])
  @@index([entrepriseId, nom])
  @@map("produit")
}

// Entités de référence légères, gérées par l'Admin (comme les
// emplacements), utilisées pour classer les produits.
model Categorie {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produits   Produit[]

  @@unique([entrepriseId, nom])
  @@map("categorie")
}

model Marque {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produits   Produit[]

  @@unique([entrepriseId, nom])
  @@map("marque")
}

model Fournisseur {
  id           String   @id @default(uuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  emailContact String?  @map("email_contact")
  telephone    String?
  photoUrl     String?  @map("photo_url")
  // Saisi manuellement par l'Admin (délai annoncé par le fournisseur),
  // pas calculé depuis l'historique des réceptions — on n'a pas encore
  // de date de commande, seulement une date de réception.
  delaiLivraisonJours Int?     @map("delai_livraison_jours")
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise       Entreprise           @relation(fields: [entrepriseId], references: [id])
  produitsAssocies FournisseurProduit[]
  mouvements       Mouvement[]

  @@index([entrepriseId])
  @@map("fournisseur")
}

model FournisseurProduit {
  fournisseurId String @map("fournisseur_id")
  produitId     String @map("produit_id")

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id])
  produit     Produit     @relation(fields: [produitId], references: [id])

  @@id([fournisseurId, produitId])
  @@map("fournisseur_produit")
}

// État courant du stock, maintenu à chaque mouvement (voir justification
// dans la documentation d'architecture : évite un recalcul par somme à
// chaque lecture).
model Stock {
  produitId     String @map("produit_id")
  emplacementId String @map("emplacement_id")
  quantite      Int    @default(0)

  produit     Produit     @relation(fields: [produitId], references: [id])
  emplacement Emplacement @relation(fields: [emplacementId], references: [id])

  @@id([produitId, emplacementId])
  @@map("stock")
}

// Mouvements immuables : jamais modifiés ni supprimés après création
// (traçabilité — voir règles d'intégrité de l'architecture validée).
model Mouvement {
  id            String        @id @default(uuid())
  entrepriseId  String        @map("entreprise_id")
  produitId     String        @map("produit_id")
  emplacementId String        @map("emplacement_id")
  type          TypeMouvement
  quantite      Int
  fournisseurId String?       @map("fournisseur_id")
  utilisateurId String        @map("utilisateur_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  entreprise  Entreprise   @relation(fields: [entrepriseId], references: [id])
  produit     Produit      @relation(fields: [produitId], references: [id])
  emplacement Emplacement  @relation(fields: [emplacementId], references: [id])
  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  utilisateur Utilisateur  @relation(fields: [utilisateurId], references: [id])

  @@index([produitId, createdAt])
  @@index([entrepriseId, createdAt])
  @@map("mouvement")
}

model Alerte {
  id                      String       @id @default(uuid())
  entrepriseId            String       @map("entreprise_id")
  produitId               String       @map("produit_id")
  type                    TypeAlerte
  statut                  StatutAlerte @default(ACTIVE)
  quantiteAuDeclenchement Int          @map("quantite_au_declenchement")
  createdAt               DateTime     @default(now()) @map("created_at")
  resolvedAt              DateTime?    @map("resolved_at")

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  produit    Produit    @relation(fields: [produitId], references: [id])

  @@index([entrepriseId, statut])
  @@map("alerte")
}
