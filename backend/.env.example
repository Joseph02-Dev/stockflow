# Application
# FRONTEND_URL est obligatoire en production (CORS), en https.
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL (à renseigner lors du ticket TECH-002)
DATABASE_URL=postgresql://user:password@localhost:5432/stockflow

# Authentification JWT — obligatoires (le démarrage s'arrête sinon).
# 32 caractères au moins, deux valeurs distinctes : openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Console opérateur — secret DISTINCT de JWT_ACCESS_SECRET et JWT_REFRESH_SECRET.
# Absent ou identique à l'un d'eux : la console reste fermée.
JWT_CONSOLE_SECRET=
JWT_CONSOLE_EXPIRATION=2h

# Service d'email transactionnel (TECH-005)
EMAIL_PROVIDER=dev
# Requis quand EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM=

# Invitation d'utilisateur (AUTH-003)
INVITATION_EXPIRATION=7d

# Aucune valeur réelle ne doit jamais être commitée dans ce fichier.
# Ce fichier sert uniquement de modèle pour créer un .env local (ignoré par git).

# Stockage des images (Cloudinary) — nécessaire pour les photos produits,
# fournisseurs et utilisateurs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Montée en charge (toutes facultatives : sans elles, un seul processus,
# pool de 10 connexions, limitation de débit en mémoire — comme avant).
# Connexions PostgreSQL par processus. Total = DB_POOL_MAX × WEB_CONCURRENCY
# × nombre d'instances : à garder sous le max_connections de la base.
DB_POOL_MAX=10
# Garde-fous (facultatifs) : attente d'une connexion libre et durée maximale d'une requête SQL.
# DB_DELAI_CONNEXION_MS=5000
# DB_DELAI_REQUETE_MS=30000
# Nombre de processus API dans le conteneur (idéalement = nombre de vCPU).
WEB_CONCURRENCY=1
# Compteurs de limitation de débit partagés entre processus/instances.
# Obligatoire dès que WEB_CONCURRENCY > 1 ou plusieurs instances.
REDIS_URL=

# Journaux JSON (facultatif) : debug, info (défaut), warn, error, silent.
# LOG_LEVEL=info

# Interrupteurs globaux (facultatif) : couper une fonctionnalité pour tous,
# sans livrer de code. Valeurs : import, rapports, uploads (séparées par des virgules).
# FONCTIONNALITES_DESACTIVEES=

# Suivi des erreurs (facultatif) : DSN du projet Sentry de l'API (Settings > Client Keys).
# Sans valeur, rien n'est envoyé. Côté Vercel, le frontend lit VSENTRY_DSN au build.
# SENTRY_DSN=
