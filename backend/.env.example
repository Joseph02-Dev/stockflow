# Application
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL (à renseigner lors du ticket TECH-002)
DATABASE_URL=postgresql://user:password@localhost:5432/stockflow

# Authentification JWT (à renseigner lors du ticket AUTH-001-BE)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Console opérateur — secret DISTINCT de JWT_ACCESS_SECRET et JWT_REFRESH_SECRET.
# Absent ou identique à l'un d'eux : la console reste fermée.
JWT_CONSOLE_SECRET=
JWT_CONSOLE_EXPIRATION=2h

# Service d'email transactionnel (TECH-005)
EMAIL_PROVIDER=dev
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Invitation d'utilisateur (AUTH-003)
INVITATION_EXPIRATION=7d

# Aucune valeur réelle ne doit jamais être commitée dans ce fichier.
# Ce fichier sert uniquement de modèle pour créer un .env local (ignoré par git).

# Stockage des images (Cloudinary) — nécessaire pour les photos produits,
# fournisseurs et utilisateurs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Montée en charge (toutes facultatives : sans elles, un seul processus,
# pool de 10 connexions, limitation de débit en mémoire — comme avant).
# Connexions PostgreSQL par processus. Total = DB_POOL_MAX × WEB_CONCURRENCY
# × nombre d'instances : à garder sous le max_connections de la base.
DB_POOL_MAX=10
# Nombre de processus API dans le conteneur (idéalement = nombre de vCPU).
WEB_CONCURRENCY=1
# Compteurs de limitation de débit partagés entre processus/instances.
# Obligatoire dès que WEB_CONCURRENCY > 1 ou plusieurs instances.
REDIS_URL=
